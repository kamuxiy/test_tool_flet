buffers: {
    size_kb: 153600
    fill_policy: RING_BUFFER
}
buffers: {
    size_kb: 2048
    fill_policy: RING_BUFFER
}
buffers: {
    size_kb: 10240
    fill_policy: RING_BUFFER
}
data_sources: {
    config {
        name: "android.gpu.memory"
    }
}
data_sources: {
    config {
        name: "linux.process_stats"
        target_buffer: 1
        process_stats_config {
            scan_all_processes_on_start: true
            proc_stats_poll_ms: 60000
        }
    }
}
data_sources: {
    config {
        name: "android.surfaceflinger.frametimeline"
    }
}
data_sources: {
    config {
        name: "linux.ftrace"
        target_buffer: 0
        ftrace_config {
            symbolize_ksyms: true
            atrace_categories: "aidl"
            atrace_categories: "am"
            atrace_categories: "audio"
            atrace_categories: "binder_driver"
            atrace_categories: "binder_lock"
            atrace_categories: "camera"
            atrace_categories: "dalvik"
            atrace_categories: "disk"
            atrace_categories: "freq"
            atrace_categories: "gfx"
            atrace_categories: "hal"
            atrace_categories: "idle"
            atrace_categories: "input"
            atrace_categories: "memreclaim"
            atrace_categories: "network"
            atrace_categories: "nnapi"
            atrace_categories: "pdx"
            atrace_categories: "pm"
            atrace_categories: "power"
            atrace_categories: "res"
            atrace_categories: "rro"
            atrace_categories: "rs"
            atrace_categories: "sched"
            atrace_categories: "sm"
            atrace_categories: "ss"
            atrace_categories: "sync"
            atrace_categories: "thermal"
            atrace_categories: "vibrator"
            atrace_categories: "video"
            atrace_categories: "view"
            atrace_categories: "webview"
            atrace_categories: "wm"
            atrace_categories: "ftrace_print"
            atrace_apps: "*"
            ftrace_events: "sched/sched_switch"
            ftrace_events: "power/suspend_resume"
            ftrace_events: "sched/sched_wakeup"
            ftrace_events: "sched/sched_wakeup_new"
            ftrace_events: "sched/sched_waking"
            ftrace_events: "power/cpu_frequency"
            ftrace_events: "power/cpu_frequency_limits"
            ftrace_events: "power/cpu_idle"
            ftrace_events: "power/gpu_frequency"
            ftrace_events: "sched/sched_process_exit"
            ftrace_events: "sched/sched_process_free"
            ftrace_events: "task/task_newtask"
            ftrace_events: "task/task_rename"
            ftrace_events: "ftrace/print"
            buffer_size_kb: 24576
            drain_period_ms: 1000
        }
    }
}
data_sources: {
    config {
        name: "linux.sys_stats"
        target_buffer: 1
        sys_stats_config {
            meminfo_period_ms: 1000
            meminfo_counters: MEMINFO_MEM_TOTAL
            meminfo_counters: MEMINFO_MEM_FREE
            meminfo_counters: MEMINFO_MEM_AVAILABLE
            meminfo_counters: MEMINFO_BUFFERS
            meminfo_counters: MEMINFO_CACHED
            meminfo_counters: MEMINFO_SWAP_CACHED
            meminfo_counters: MEMINFO_ACTIVE
            meminfo_counters: MEMINFO_INACTIVE
            meminfo_counters: MEMINFO_ACTIVE_ANON
            meminfo_counters: MEMINFO_INACTIVE_ANON
            meminfo_counters: MEMINFO_ACTIVE_FILE
            meminfo_counters: MEMINFO_INACTIVE_FILE
            meminfo_counters: MEMINFO_UNEVICTABLE
            meminfo_counters: MEMINFO_SWAP_TOTAL
            meminfo_counters: MEMINFO_SWAP_FREE
            meminfo_counters: MEMINFO_DIRTY
            meminfo_counters: MEMINFO_WRITEBACK
            meminfo_counters: MEMINFO_ANON_PAGES
            meminfo_counters: MEMINFO_MAPPED
            meminfo_counters: MEMINFO_SHMEM
            stat_period_ms: 1000
            stat_counters: STAT_CPU_TIMES
            stat_counters: STAT_FORK_COUNT
        }
    }
}


data_sources {
    config {
        name: "linux.system_info"
    }
}

duration_ms: 10000
write_into_file: true
file_write_period_ms: 2500
flush_period_ms: 30000
incremental_state_config {
    clear_period_ms: 5000
}
